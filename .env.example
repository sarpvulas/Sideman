# Copy to .env.local and fill in. Never commit real values.

# Required for AI features (score analysis, voicing exercises, coaching).
# Server-side only: never prefix with NEXT_PUBLIC_. Get one at https://aistudio.google.com/app/apikey
# If unset, the app still runs: score upload falls back to a built-in sample
# lead sheet, and exercise/coaching endpoints return a clear error.
GEMINI_API_KEY=

# Optional. Max Gemini-backed requests per client IP per hour (in-memory,
# per server instance). Default: 20.
RATE_LIMIT_PER_HOUR=
